RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
WEBHOOK_SECRET=placeholder_for_now
ANTHROPIC_API_KEY=sk-ant-xxxx
# Only needed for identity-linked API keys (free / console keys), which require
# the workspace to be named on every request. Leave blank for standard paid keys.
ANTHROPIC_WORKSPACE_ID=
# Optional: override the agent model. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=
# LLM provider for the checkout agent: "anthropic" (default) or "groq" (free tier for testing).
LLM_PROVIDER=anthropic
# Groq (free, OpenAI-compatible) — get a key at https://console.groq.com/keys.
# Used only when LLM_PROVIDER=groq.
GROQ_API_KEY=
# Optional: override the Groq model. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
PORT=3000
NGROK_URL=placeholder_for_now