{
  "name": "vortex-commerce",
  "version": "2.0.0",
  "description": "Vortex Commerce — multi-vertical agentic commerce layer on Razorpay test-mode + SerpApi + Groq + LangChain.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "audit": "node src/audit/viewer.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\""
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KalpanaBhaskar/Agentic-Commerce.git"
  },
  "keywords": [
    "razorpay",
    "agentic-commerce",
    "acp",
    "claude",
    "tool-use"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KalpanaBhaskar/Agentic-Commerce/issues"
  },
  "homepage": "https://github.com/KalpanaBhaskar/Agentic-Commerce#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@langchain/core": "^1.2.17",
    "@langchain/groq": "^1.3.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "langchain": "^1.5.16",
    "langfuse": "^3.39.2",
    "langsmith": "^0.10.11",
    "razorpay": "^2.9.8",
    "serpapi": "^2.2.1",
    "zod": "^4.6.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
